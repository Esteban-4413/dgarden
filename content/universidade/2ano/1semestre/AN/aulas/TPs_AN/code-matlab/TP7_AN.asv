%[text] *Exercicio 9 (Interpolação polinomial)*
x=[0 0.5 1];
y=exp(x);
p=polyfit(x,y,2) % polinómio interpolador de grau 2 %[output:8433e010]
%[text] Representação gráfica de $f(x) = e^x \n$ e $&dollar&;p(x)&dollar&;$
fplot(@exp, [0,1]) %[output:03f461c3]
%[text] 
%[text] Polinomio interpolador
% p2=@(t) p(1)*t.^2+p*t+p(3)
% p2(0.6) % polyval(p,0.6)

% em alternativa
clear p2
p2=@(t) polyval(p,t) %[output:595a8e13]
polyval(p,0.6) % ou p2(0.6) %[output:80d81ab4]
exp(0.6) %[output:3d4dfa3e]
erro=abs(p2(0.6)-exp(0.6)) %[output:06301651]
%[text] Representação gráfica de $p\_2(x)$
clf % clear figure %[output:18262741]
fplot(@exp,[0,1]) %[output:18262741]
hold on %[output:18262741]
fplot(p2,[0,1]) %[output:18262741]
hold off %[output:18262741]
legend('f', 'p2', 'Location', 'best') %[output:18262741]
%%
%[text] Quadratua Númerica
f=@(x) 1 + exp(-x).*sin(4*x) %[output:637f80d7]
% regra do trapezio
h = 1;
Q2 = (h/2)*(f(0)+f(1)) %[output:4d9b57ac]
% Regra de Simpson
h=(1-0)/2;
Q3=(h/3)*(f(0)+f(0.5)+f(1)) %[output:3dbfbcd7]
%[text] 
IntE=1.8250506046
abs(IntE)
%[text] 
f=@(x) 1 + exp(-x).*sin(4*x)

%Polinomio de grau 1
x=[0 1];
y=f(x);
p=polyfit(x,y,1)
p1=@(t) polyval(p,t)

%polinomio de grau 2
x=[0 0.5 1];
y=f(x);
p=polyfit(x,y,2)
p1=@(t) polyval(p,t)

clf % clear figure
fplot(f, [0,1])
hold on 
fplot(p1, [0,1])
fplot(p2,[0,1])
hold off
legend('f', 'p1', 'p2', 'Location', 'best')
xtiks([0 0.])


