views:
  - type: table
    name: Table
    filters:
      and:
        - file.hasLink("universidade/1ano/2semestre/AM/bibliografias")
    order:
      - file.name
  - type: cards
    name: View
    filters:
      or:
        - file.folder == "universidade/1ano/2semestre/AM/bibliografias"
    cardSize: 240
